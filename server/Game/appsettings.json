{
  "Server": {
    "Host": "0.0.0.0",
    "Port": 9000,
    "MaxConnections": 5000
  },
  "MySql": {
    "ConnectionString": "Server=127.0.0.1;Port=3306;Database=game;Uid=root;Pwd=123456;"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://127.0.0.1:27017",
    "DatabaseName": "game_log"
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:6379,abortConnect=false"
  },
  "Tables": {
    "Directory": "Data/Tables"
  },
  "Log": {
    "Level": "Debug",
    "Format": "[{time} {level,-5}][{thread}]{name} {message}",
    "Loggers": {
      "Server.Network": "Info",
      "Server.Database": "Info"
    },
    "Console": {
      "Enabled": true,
      "Colorful": true
    },
    "File": {
      "Enabled": true,
      "Path": "log/game.log",
      "ErrorPath": "log/error.log",
      "MaxHistoryDays": 7
    }
  }
}
